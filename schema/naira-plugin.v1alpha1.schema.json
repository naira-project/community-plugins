{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naira-project/community-plugins/schema/naira-plugin.v1alpha1.schema.json",
  "title": "Naira plugin manifest (naira-plugin.yaml)",
  "description": "Manifest for one entry in the Naira plugin index, as proposed in RFC-010. Alpha: fields may change until the plugin contract is stable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "naira.dev/v1alpha1" },
    "kind": { "const": "Plugin" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "description": "Reverse-DNS name. Equals the folder name under plugins/. Community tier uses io.github.<login-or-org>.<plugin>.",
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?){2,}$",
          "maxLength": 128
        },
        "version": {
          "description": "Semantic version of the plugin release the image digest belongs to.",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "description",
        "tier",
        "categories",
        "image",
        "nairaApiVersions",
        "source",
        "license",
        "maintainers",
        "icon"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": {
          "description": "One sentence shown in the plugin index and on the website catalog.",
          "type": "string",
          "minLength": 20,
          "maxLength": 200
        },
        "tier": {
          "description": "official | verified | community. New submissions use community; maintainers change the tier.",
          "enum": ["official", "verified", "community"]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ai-gateway",
              "inference",
              "model-registry",
              "data-catalog",
              "vector-store",
              "mcp",
              "gitops",
              "source-control",
              "observability",
              "cloud-ai-service",
              "kubernetes",
              "governance",
              "other"
            ]
          }
        },
        "image": {
          "description": "OCI image reference pinned by digest. Tags are not accepted.",
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$"
        },
        "nairaApiVersions": {
          "description": "Semver range of Naira releases the plugin works with, for example \">=0.1.2 <0.2.0\".",
          "type": "string",
          "minLength": 1
        },
        "source": {
          "description": "Public repository with the plugin source code.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "license": {
          "description": "SPDX identifier of the plugin source license (OSI-approved).",
          "type": "string",
          "minLength": 1
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "github"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "github": {
                "description": "GitHub login, without @.",
                "type": "string",
                "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9])*$"
              },
              "email": { "type": "string", "format": "email" }
            }
          }
        },
        "icon": {
          "description": "Path relative to the plugin folder. SVG preferred, PNG at least 256x256.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.(svg|png)$"
        },
        "screenshots": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "caption"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^screenshots/[A-Za-z0-9._-]+\\.(png|jpg|jpeg|webp)$"
              },
              "caption": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        },
        "collects": {
          "description": "Node and relation kinds the plugin writes to the catalog.",
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeKinds"],
          "properties": {
            "nodeKinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[^/]+$" }
            },
            "relationKinds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[^/]+$" }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "description", "required"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "description": { "type": "string", "minLength": 1 },
                  "required": { "type": "boolean" },
                  "secret": { "type": "boolean", "default": false },
                  "default": { "type": "string" }
                }
              }
            }
          }
        },
        "permissions": {
          "description": "Access the plugin needs. Declared so platform engineers can review it before installing.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kubernetes": {
              "description": "ClusterRole rules. Omit if the plugin does not read the cluster.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["apiGroups", "resources", "verbs"],
                "properties": {
                  "apiGroups": { "type": "array", "items": { "type": "string" } },
                  "resources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "verbs": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "enum": ["get", "list", "watch"] }
                  }
                }
              }
            },
            "network": {
              "description": "External systems the plugin calls, for example \"LiteLLM admin API\".",
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
